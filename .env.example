# =============================================================================
# REDPROTEGE - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# =============================================================================
# Copiar este archivo como .env y configurar los valores correspondientes.
#
# El archivo .env contiene información sensible y NO debe subirse a Git.
# El archivo .env.example sí debe mantenerse versionado.
# =============================================================================

# -----------------------------------------------------------------------------
# SEGURIDAD DE FLASK
# -----------------------------------------------------------------------------

# Clave secreta utilizada para proteger sesiones y tokens CSRF.
# Generar una clave aleatoria, larga y única para cada entorno.
SECRET_KEY="REEMPLAZAR_POR_UNA_CLAVE_SECRETA_SEGURA"

# -----------------------------------------------------------------------------
# CONEXIÓN A BASE DE DATOS MYSQL
# -----------------------------------------------------------------------------

# Dirección del servidor MySQL.
MYSQL_HOST=127.0.0.1

# Puerto de conexión MySQL.
MYSQL_PORT=3306

# Usuario de MySQL con permisos sobre la base de datos RedProtege.
# Se recomienda un usuario exclusivo con privilegios mínimos.
MYSQL_USER="redprotege_user"

# Contraseña del usuario MySQL.
MYSQL_PASSWORD="REEMPLAZAR_POR_CONTRASENA_MYSQL"

# Nombre de la base de datos.
MYSQL_DB="red_protege_db"

# -----------------------------------------------------------------------------
# ENTORNO DE EJECUCIÓN
# -----------------------------------------------------------------------------

# development = desarrollo local
# production  = producción
APP_ENV="development"

# 1 = Depuración habilitada.
# 0 = Depuración deshabilitada.
# En producción siempre debe mantenerse en 0.
FLASK_DEBUG=0

# -----------------------------------------------------------------------------
# CORREO ELECTRÓNICO
# -----------------------------------------------------------------------------

# Cuenta institucional utilizada para enviar notificaciones
# y correos de recuperación de contraseñas.
EMAIL_USUARIO="correo@ejemplo.cl"

# Contraseña de aplicación o credencial SMTP correspondiente.
EMAIL_CONTRASENA="REEMPLAZAR_POR_CREDENCIAL_DE_CORREO"

# -----------------------------------------------------------------------------
# URL BASE DEL SISTEMA
# -----------------------------------------------------------------------------

# Dirección utilizada para generar enlaces enviados por correo.
#
# Desarrollo local:
# http://127.0.0.1:5000
#
# Producción:
# https://redprotege.dominio-institucional.cl
#
# No agregar una barra final.
REDPROTEGE_BASE_URL="http://127.0.0.1:5000"